{
  "name": "haven-production-suite",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "validate:suite": "node scripts/validate-suite.mjs",
    "test:edge": "node --experimental-transform-types --test tests/edge/*.test.mjs",
    "test:e2e": "node tests/e2e/iphone-suite-smoke.test.mjs",
    "test:integration:live": "node tests/integration/live-rls.test.mjs",
    "test": "corepack pnpm run validate:suite && corepack pnpm run typecheck && corepack pnpm run lint && corepack pnpm run test:edge && corepack pnpm run test:rls && corepack pnpm run audit:functions && corepack pnpm run audit:tests && corepack pnpm run audit:docs",
    "preview:iphone": "python3 -m http.server 4173 --directory apps/iphone-suite",
    "preview:family": "python3 -m http.server 4174 --directory apps/family-dashboard",
    "mock:ai": "node scripts/mock-ai-server.mjs",
    "sync:scam-rules": "node scripts/export-scam-rules.mjs",
    "test:e2e:browser": "playwright test -c playwright.iphone.config.ts",
    "test:e2e:browser:family": "playwright test -c playwright.family.config.ts",
    "test:supabase:local": "./scripts/check-local-supabase.sh && HAVEN_LIVE_RLS=1 corepack pnpm run test:integration:live",
    "typecheck:packages": "corepack pnpm exec tsc -p tsconfig.packages.json --noEmit",
    "typecheck:elder": "corepack pnpm --dir apps/elder exec tsc -p tsconfig.json --noEmit",
    "typecheck:grandchild": "corepack pnpm --dir apps/grandchild exec tsc -p tsconfig.json --noEmit",
    "typecheck": "corepack pnpm run typecheck:packages && corepack pnpm run typecheck:elder && corepack pnpm run typecheck:grandchild && corepack pnpm run typecheck:family && corepack pnpm run typecheck:carer",
    "lint": "corepack pnpm exec eslint . --max-warnings=0",
    "build:family": "corepack pnpm --dir apps/family build",
    "test:e2e:browser:all": "playwright test -c playwright.family.config.ts && playwright test -c playwright.iphone.config.ts",
    "quality:check": "corepack pnpm run lint && corepack pnpm run typecheck && corepack pnpm run build:family",
    "verify:core": "./scripts/ci/verify-core.sh",
    "verify:browser": "./scripts/ci/verify-browser.sh",
    "verify:supabase:local": "./scripts/ci/verify-local-supabase.sh",
    "staging:mint-jwts": "node scripts/ci/mint-staging-auth-jwts.mjs --write",
    "smoke:hosted": "./scripts/ci/smoke-hosted-integrations.sh",
    "smoke:vendors:staging": "node scripts/ci/smoke-vendors-staging.mjs",
    "audit:env": "node scripts/ci/audit-env-hygiene.mjs",
    "build": "corepack pnpm run build:family",
    "typecheck:family": "corepack pnpm --dir apps/family exec tsc -p tsconfig.json --noEmit",
    "typecheck:carer": "corepack pnpm exec tsc -p apps/carer/tsconfig.json --noEmit",
    "verify:edge": "./scripts/ci/verify-edge-functions.sh",
    "verify:sql": "./scripts/ci/verify-sql.sh",
    "audit:rls": "node scripts/ci/audit-rls-coverage.mjs",
    "test:rls": "node tests/rls/rls-policy-audit.mjs && node tests/rls/storage-policy-audit.mjs",
    "audit:functions": "node scripts/ci/audit-function-coverage.mjs",
    "audit:docs": "node scripts/ci/audit-docs-truth.mjs",
    "audit:tests": "node scripts/ci/audit-test-substance.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": ">=0.8.13",
      "semver": ">=7.5.2"
    },
    "packageExtensions": {
      "babel-preset-expo@10.0.2": {
        "dependencies": {
          "metro-transform-plugins": "0.80.12"
        }
      },
      "@expo/cli@0.17.13": {
        "dependencies": {
          "metro": "0.80.12",
          "metro-resolver": "0.80.12"
        }
      },
      "@expo/metro-config@0.17.8": {
        "dependencies": {
          "metro": "0.80.12",
          "metro-cache": "0.80.12",
          "metro-cache-key": "0.80.12",
          "metro-resolver": "0.80.12",
          "metro-transform-worker": "0.80.12"
        }
      }
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-2p57-rm9w-gvfp"
      ]
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.60.0",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0"
  }
}
